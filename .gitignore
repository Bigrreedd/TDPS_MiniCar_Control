# =================================================
# UESTCHN3018 TDPS MiniCar Project .gitignore
# =================================================

# 1. 忽略 Keil 编译生成的中间二进制文件 (Prohibit Intermediate Files)
# -------------------------------------------------
Objects/
Listings/
DebugConfig/
*.o
*.d
*.crf
*.axf
*.elf
*.hex
*.bin
*.htm
*.dep
*.lnp
*.lst
*.map
*.iex
*.build_log.htm
*.htm
*.pdf

# 2. 忽略 Keil 本地个人配置 (Strictly Prohibit .uvoptx)
# -------------------------------------------------
# 警告：必须保留 .uvprojx (工程架构)，但必须屏蔽 .uvoptx (调试器与断点信息)
*.uvoptx
*.uvguix.*
*.bak
*.sav

# 3. 忽略仿真器与底层调试产生的临时文件
# -------------------------------------------------
JLinkLog.txt
JLinkSettings.ini
*.scvd

# 4. 忽略 VS Code 本地环境配置
# -------------------------------------------------
.vscode/
.history/

# 5. 忽略 AI 辅助工具 (Aider) 产生的非工程文件 (隐私保护)
# -------------------------------------------------
.aider*
.aider/

# 6. 忽略手动创建的备份文件夹 (防止递归追踪错误)
# -------------------------------------------------
git_backup/
backup/
*old/
*temp/

# 7. 忽略操作系统产生的垃圾文件
# -------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store

# 8. 忽略 Python 环境缓存 (如果你在终端误开了 conda)
# -------------------------------------------------
__pycache__/
*.pyc

# 忽略背景文档和本地文档
TDPS_Background/
TDPS_Document/

# 忽略 Obsidian 配置
.obsidian/

# 忽略本地图片/视频读取工具输出
image_reader/
video_reader/